rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each student can only read and write their own data: users/{their uid}.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // A student's notifications (the bell). Only the server writes them; the student can
    // read them, mark them read and delete them.
    match /users/{uid}/inbox/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow create: if false;
    }

    // A student's saved AI Assistant conversations.
    match /users/{uid}/chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Public read-only copies of chats a student chose to share (link only, no listing).
    match /shared/{shareId} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    // Text of a student's uploaded study materials.
    match /users/{uid}/materials/{materialId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Certificates: anyone with the ID can check one on /verify (no listing).
    // Only the server creates them, after re-marking the quiz (/api/certificates).
    // A student can delete their own when they delete their account.
    match /certificates/{certId} {
      allow get: if true;
      // only the server writes certificates, after it re-marks the quiz (/api/certificates)
      allow create, update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Student reviews of StudentOS: one per student (id = their uid).
    // Anyone can read approved ones; a student can read, write and delete their own.
    // New or edited reviews must be unapproved; StudentOS approves them in the console.
    match /reviews/{uid} {
      allow get: if resource.data.approved == true || (request.auth != null && request.auth.uid == uid);
      allow list: if resource.data.approved == true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.approved == false
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() >= 20 && request.resource.data.text.size() <= 500
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.role is string && request.resource.data.role.size() <= 90;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Push notification token for placement alerts: one per student, only they can
    // read or change it (the server sends with the service account).
    match /pushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Colleges (college dashboard at /college) ----------
    function isStaff(cid) {
      return request.auth != null && exists(/databases/$(database)/documents/colleges/$(cid)/staff/$(request.auth.uid));
    }
    function isCollegeAdmin(cid) {
      return isStaff(cid) && get(/databases/$(database)/documents/colleges/$(cid)/staff/$(request.auth.uid)).data.role == "admin";
    }
    match /colleges/{cid} {
      // signed-in students see the college name when they enter its code
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid && request.resource.data.id == cid;
      allow update: if isCollegeAdmin(cid);
      allow delete: if false;
      // faculty: the owner becomes admin; others join as teacher with the faculty code
      match /staff/{uid} {
        allow read: if isStaff(cid);
        allow create: if request.auth != null && request.auth.uid == uid && (
          (get(/databases/$(database)/documents/colleges/$(cid)).data.owner == uid && request.resource.data.role == "admin") ||
          (request.resource.data.role == "teacher" && request.resource.data.staffCode == get(/databases/$(database)/documents/colleges/$(cid)/private/keys).data.staffCode)
        );
        allow update, delete: if isCollegeAdmin(cid);
      }
      // the faculty join code: staff can read it, only admins change it
      match /private/{key} {
        allow read: if isStaff(cid);
        allow write: if isCollegeAdmin(cid);
      }
      // StudentOS partner drives offered to this college: only the server writes them
      // (/api/partner); the college's staff can read them and decide through the server.
      match /partner/{pid} {
        allow read: if isStaff(cid);
        allow write: if false;
      }
      // campus placement drives: the admin or placement coordinator posts them; other staff and joined students read them
      match /drives/{did} {
        allow read: if isStaff(cid) || (request.auth != null && exists(/databases/$(database)/documents/colleges/$(cid)/members/$(request.auth.uid)));
        allow write: if isStaff(cid) && get(/databases/$(database)/documents/colleges/$(cid)/staff/$(request.auth.uid)).data.role in ["admin", "placement"];
        // applications: a student creates and reads only their own; the admin or placement coordinator updates rounds, links and offers;
        // the student can only answer the offer
        match /apps/{uid} {
          allow read: if isStaff(cid) || (request.auth != null && request.auth.uid == uid);
          allow create: if request.auth != null && request.auth.uid == uid
            && exists(/databases/$(database)/documents/colleges/$(cid)/members/$(uid))
            && request.resource.data.uid == uid && request.resource.data.status == "applied"
            && request.resource.data.round == 0 && request.resource.data.links.size() == 0 && !("offer" in request.resource.data);
          allow delete: if isStaff(cid) && get(/databases/$(database)/documents/colleges/$(cid)/staff/$(request.auth.uid)).data.role in ["admin", "placement"];
          allow update: if (isStaff(cid) && get(/databases/$(database)/documents/colleges/$(cid)/staff/$(request.auth.uid)).data.role in ["admin", "placement"])
            || (request.auth != null && request.auth.uid == uid && "offer" in resource.data
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["decision", "decidedAt", "updatedAt"]));
          allow delete: if isCollegeAdmin(cid);
        }
      }
      // a student's shared summary: only they write it; staff read it; they or an admin delete it
      // joining needs the college's student join code, saved in the summary as `code`
      match /members/{uid} {
        allow read: if isStaff(cid);
        allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.uid == uid
          && request.resource.data.code is string
          && exists(/databases/$(database)/documents/collegeCodes/$(request.resource.data.code))
          && get(/databases/$(database)/documents/collegeCodes/$(request.resource.data.code)).data.cid == cid;
        allow delete: if (request.auth != null && request.auth.uid == uid) || isCollegeAdmin(cid);
      }
    }
    // student join codes → college id
    // Careers page roles: everyone can read; the StudentOS team edits them through the server.
    match /site/careers {
      allow read: if true;
      allow write: if false;
    }
    // Careers applications and AI interviews: only the server reads and writes them.
    match /careerApps/{token} {
      allow read, write: if false;
    }
    match /collegeCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && get(/databases/$(database)/documents/colleges/$(request.resource.data.cid)).data.owner == request.auth.uid;
      allow update, delete: if false;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
