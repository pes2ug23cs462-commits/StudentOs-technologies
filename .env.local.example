# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: “most viewed” YouTube videos. Google Cloud console → APIs & Services →
# enable “YouTube Data API v3” → Credentials → Create API key. Server-only, never NEXT_PUBLIC.
YOUTUBE_API_KEY=

# AI assistant (server only, never NEXT_PUBLIC). Free keys:
#   Groq: console.groq.com → API Keys        (main)
#   Cerebras: cloud.cerebras.ai → API Keys   (optional backup)
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Optional: change models if a provider retires one
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# CEREBRAS_MODEL=gpt-oss-120b
